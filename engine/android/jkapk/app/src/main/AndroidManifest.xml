<?xml version="1.0" encoding="utf-8"?>
<!-- #114 jkapk (T1) — minimal launcher manifest.
     package is declared in build.gradle.kts:android.namespace (AGP 8 convention).
     icon = framework builtin default Android icon (no binary resource committed);
     the single resource is res/values/strings.xml (app label "JK"). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- POST http://localhost:8090/talk = 앱의 유일 네트워크 사용(루프백) —
         usesCleartextTraffic는 루프백 http 전용 원존(D3 — LAN 무인증 노출 수수
         원장 승계: 8090은 loopback 기본 bind). IME 음성입력 별도 권한 0(D7). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- #121 v2 T2 — 구두 버튼 전사 사슬(D6 v2 원장행의 마이크 축). 런타임
         권한 — 거부 = fail-closed 정직 거부 표기(조용한 마이크 개방 금지). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>