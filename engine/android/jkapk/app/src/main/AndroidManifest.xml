<?xml version="1.0" encoding="utf-8"?>
<!-- #114 jkapk (T1) — minimal launcher manifest.
     package is declared in build.gradle.kts:android.namespace (AGP 8 convention).
     icon = framework builtin default Android icon (no binary resource committed);
     the single resource is res/values/strings.xml (app label "JK"). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- POST http://localhost:8090/talk = 앱의 유일 네트워크 사용(루프백) —
         usesCleartextTraffic는 루프백 http 전용 원존(D3 — LAN 무인증 노출 수수
         원장 승계: 8090은 loopback 기본 bind). IME 음성입력 별도 권한 0(D7). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- #121 v2 T2 — 구두 버튼 전사 사슬(D6 v2 원장행의 마이크 축). 런타임
         권한 — 거부 = fail-closed 정직 거부 표기(조용한 마이크 개방 금지). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 기본 음성 인식(SpeechRecognizer) — Android 11+ 패키지 가시성: 인식
         서비스를 찾으려면 RecognitionService 질의 선언이 필요(없으면
         isRecognitionAvailable=false). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- #124 구두 서비스 분리 T1 — 마이크 FGS(JkVoiceService). 스펙 §3 계약:
         포그라운드 인터랙션(구두 홀드 터치)에서만 startForegroundService —
         Android 14+ 뒤에서 mic 시작 = SecurityException(fail-closed 원존).
         FGS 소유 안내 알림(Importance LOW — 소음 0) = POST_NOTIFICATIONS.
         평시 녹음 0 — 홀드 동안만 개방, 발화 후 stopSelf. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- #123 폰 브라우저 T1 — BrowserActivity. exported=true(뒤 라인: DeX
             그리드/Termux am start 개봉 승계), configChanges = DeX 리사이즈 시
             WebView 상태 보존(재생성 금지). -->
        <activity
            android:name=".BrowserActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden" />

        <!-- #124 구두 서비스 T1 — 마이크 FGS(기본 STT+/talk 유일 소관). 두 창의
             [구두] 홀드에서 START/STOP 인텐트 릴레이. exported=false(내부 전용). -->
        <service
            android:name=".JkVoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>
